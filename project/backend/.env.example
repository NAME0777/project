# ==== Django ====
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ==== PostgreSQL ====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/notes_hub

# ==== CORS (frontend origin) ====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==== Institution email domain allowed to register/login ====
ALLOWED_EMAIL_DOMAIN=kmitl.ac.th

# ==== minIO / S3-compatible storage (leave USE_S3_STORAGE=False to store files on local disk) ====
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=notes-hub
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
